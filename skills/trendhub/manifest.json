{
  "schema": "trendhub-skill-v2",
  "name": "trendhub",
  "skillVersion": "2.0",
  "productVersion": "2.0.3",
  "description": "Evidence-backed AI content workspace with persistent projects, user-controlled AI, editable artifacts, review stages, 21 stable MCP tools and protocol-native Resources.",
  "namespace": {
    "capabilityPrefix": "trendhub.",
    "resourceScheme": "trendhub://"
  },
  "resources": [
    "trendhub://namespace",
    "trendhub://contracts/evidence",
    "trendhub://capabilities",
    "trendhub://methodology",
    "trendhub://sources"
  ],
  "workflows": [
    "workflows/trend-discovery.md",
    "workflows/brand-radar.md",
    "workflows/campaign-research.md",
    "workflows/content-research.md",
    "workflows/content-creation.md",
    "workflows/trend-validation.md"
  ],
  "policies": [
    "policies/evidence.md",
    "policies/confidence.md",
    "policies/reliability.md",
    "policies/forecasting.md",
    "policies/model-routing.md"
  ],
  "compatibility": {
    "toolCount": 21,
    "toolNames": "stable-unprefixed",
    "breakingRename": false
  },
  "invariants": [
    "missing-is-not-zero",
    "released-is-not-operating",
    "adapters-do-not-own-truth",
    "evidence-state-is-explicit",
    "entity-research-is-not-hotlist-only",
    "raw-evidence-is-not-the-product-summary",
    "model-output-is-not-evidence",
    "user-ai-credentials-stay-in-user-runtime"
  ],
  "routing": {
    "entityFirst": {
      "intents": [
        "brand",
        "company",
        "commercial-place",
        "product",
        "campaign",
        "business-subject"
      ],
      "tool": "professional_intelligence",
      "rule": "Actively acquire subject-specific public evidence first; generic hotlist absence is never treated as subject absence."
    },
    "topicFirst": {
      "intents": [
        "topic",
        "hotspot",
        "issue",
        "meme",
        "event-topic"
      ],
      "tool": "analyze_topic",
      "rule": "Use for topic spread/meaning rather than business-entity research."
    },
    "rawTrending": {
      "intents": [
        "what-is-trending-now",
        "current-ranking"
      ],
      "tool": "get_trending",
      "rule": "Use only for current lists/rankings."
    }
  }
}
